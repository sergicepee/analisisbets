# ── ESPN ──
# ESPN es la fuente principal y no necesita clave. Ponlo en false para usar solo CSV.
USE_ESPN=true

# ── Supabase ── Project Settings > API
# Solo se usan en servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth (cuentas) ── Project Settings > API
# Estas dos SÍ llevan NEXT_PUBLIC_: la anon/publishable key es pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Opcionales ──
APP_TIMEZONE=Europe/Madrid
# Limitar a ligas concretas (IDs internos de PICKZONE). Ej: 140,39,135
LEAGUE_IDS=
# Últimos partidos por equipo para calcular medias (3-20).
FORM_MATCHES=10
# Máx. partidos analizados en Top 3 y Estadísticas por carga
MAX_ANALYSIS_FIXTURES=12
# Mínimo de partidos guardados para mostrar "media de liga"
MIN_LEAGUE_SAMPLE=20
# Oculta el banner/página de Premium (maqueta)
SHOW_PREMIUM_BANNER=true

# ── Menú de perfil (opcionales) ──
# Si lo rellenas, aparece "Canal de Telegram" en el menú de usuario.
NEXT_PUBLIC_TELEGRAM_URL=
# Email de contacto que se muestra en Ayuda, Colaboración, Privacidad y Términos.
NEXT_PUBLIC_SUPPORT_EMAIL=
# URL pública usada por los retornos de Stripe (en Vercel, la URL principal de la web).
SITE_URL=http://localhost:3000
# Stripe Dashboard > Developers > API keys / Webhooks. Nunca uses NEXT_PUBLIC_ para estas claves.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de los precios recurrentes semanal, mensual y anual creados en Stripe.
STRIPE_PRICE_WEEKLY_ID=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_ANNUAL_ID=
