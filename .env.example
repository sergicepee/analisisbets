# Limitar a ligas concretas (IDs de API-Football separados por coma). Ej: 140,39,135
LEAGUE_IDS=
# Últimos partidos por equipo para calcular medias (3-10). Con plan gratis usa 3-5.
FORM_MATCHES=5
# Máx. partidos analizados en Top 3 y Estadísticas por carga (protege la cuota)
