# ── API-Football (API-Sports) ── https://dashboard.api-football.com
# Sin esta clave la app funciona en MODO DEMO con datos de ejemplo.
API_FOOTBALL_KEY=

# ── Supabase ── Project Settings > API
# Solo se usan en servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth (cuentas) ── Project Settings > API
# Estas dos SÍ llevan NEXT_PUBLIC_: la anon/publishable key es pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Opcionales ──
APP_TIMEZONE=Europe/Madrid
# Limitar a ligas concretas (IDs de API-Football separados por coma). Ej: 140,39,135
LEAGUE_IDS=
# Últimos partidos por equipo para calcular medias (3-10). Con plan gratis usa 3-5.
FORM_MATCHES=5
# Máx. partidos analizados en Top 3 y Estadísticas por carga (protege la cuota)
MAX_ANALYSIS_FIXTURES=12
# No se hacen llamadas "no esenciales" si quedan menos de N solicitudes diarias
QUOTA_RESERVE=8
# Mínimo de partidos guardados para mostrar "media de liga"
MIN_LEAGUE_SAMPLE=20
# Pausa mínima entre llamadas a la API (ms). Plan gratis (10/min): 6500. Planes de pago: 0
API_MIN_INTERVAL_MS=0
# Oculta el banner/página de Premium (maqueta)
SHOW_PREMIUM_BANNER=true
